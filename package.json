{
  "name": "sistema-autenticacao-token",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "start": "node --env-file=.env dist/app.js",
    "prestart": "npm run build",
    "start:dev": "tsx watch src/app.ts",
    "start:dev2": "NODE_OPTIONS='--import=tsx' node --env-file=.env src/app.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:bdd": "NODE_ENV=test node --import=tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js tests/bdd/features --import tests/bdd/support/hooks.ts --import tests/bdd/steps/**/*.steps.ts --format progress-bar",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:load": "node --import=tsx tests/load/run-load.ts all",
    "test:load:auth": "node --import=tsx tests/load/run-load.ts auth",
    "test:load:user-flow": "node --import=tsx tests/load/run-load.ts user-flow",
    "test:load:constant": "LOAD_PROFILE=constant node --import=tsx tests/load/run-load.ts all",
    "test:load:spike": "LOAD_PROFILE=spike node --import=tsx tests/load/run-load.ts all",
    "test:nonfunctional": "npm run test:security && npm run test:load",
    "test": "npm run test:unit && npm run test:integration && npm run test:bdd",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "20.10.8",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "prisma": "^5.8.1",
    "supertest": "^7.1.1",
    "testcontainers": "^11.7.2",
    "tsx": "^4.7.0",
    "typescript": "5.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "autocannon": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
